generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model TeamProfile {
  teamId            Int                 @id
  teamName          String
  teamNumber        String              @unique
  robotName         String?
  teamGrade         String?
  teamOrg           String?
  teamCity          String?
  teamRegion        String?
  teamCountry       String?
  programCode       String              @default("")
  programId         Int                 @default(0)
  teamEventRegion   String?
  FavoriteTeam      FavoriteTeam[]
  TeamNotes         TeamNote[]
  TeamSeasonProfile TeamSeasonProfile[]

  @@unique([teamId, teamNumber])
}

model TeamSeasonProfile {
  id                      Int         @id @default(autoincrement())
  teamId                  Int
  teamNumber              String
  seasonId                Int
  seasonName              String
  mu                      Float
  sigma                   Float
  openSkill               Float
  openSkillRank           Int
  opr                     Float
  dpr                     Float
  ccwm                    Float
  oprCum                  Float
  dprCum                  Float
  eventCount              Int
  topProgSkills           Int
  topDriverSkills         Int
  skillsRank              Int
  qualMatchCount          Int
  elimMatchCount          Int
  qualMatchWins           Int
  elimMatchWins           Int
  qualMatchLosses         Int
  elimMatchLosses         Int
  qualMatchWinPercentage  Float
  elimMatchWinPercentage  Float
  totalMatchWinPercentage Float
  qualToRegionals         Boolean
  awardQualToWorlds       Boolean
  driverSkills            Int         @default(0)
  progSkills              Int         @default(0)
  totalSkills             Int         @default(0)
  TeamProfile             TeamProfile @relation(fields: [teamId, teamNumber], references: [teamId, teamNumber], onDelete: Cascade)

  @@unique([teamId, seasonId])
  @@unique([teamNumber, seasonId])
}

model SeasonAnalysis {
  seasonId                   Int      @id
  seasonName                 String   @unique
  numberOfTeams              Int
  numberOfEvents             Int
  lastEventDate              DateTime
  numberOfRegionalQualifiers Int?
  numberOfWorldsQualifiers   Int?
}

model TeamNote {
  id           Int         @id @default(autoincrement())
  teamId       Int
  note         Json
  userId       String?
  seasonId     Int
  teamNumber   String
  notesGroupId Int?
  NotesGroup   NotesGroup? @relation(fields: [notesGroupId], references: [id])
  team         TeamProfile @relation(fields: [teamId, teamNumber], references: [teamId, teamNumber], onDelete: Cascade)

  @@unique([userId, seasonId, teamNumber, teamId])
  @@unique([notesGroupId, seasonId, teamNumber, teamId])
}

model NotesGroup {
  id       Int        @id @default(autoincrement())
  joinCode String     @unique
  name     String
  notes    TeamNote[]
  users    User[]     @relation("UserNotesGroups")
}

model User {
  id                String              @id
  email             String?             @unique
  firstName         String?
  lastName          String?
  username          String?             @unique
  notesGroupId      Int?
  favoriteEvents    FavoriteEvent[]
  favoriteTeams     FavoriteTeam[]
  MatchNotification MatchNotification[]
  notesGroups       NotesGroup[]        @relation("UserNotesGroups")
}

model FavoriteTeam {
  id         Int         @id @default(autoincrement())
  userId     String
  teamId     Int
  teamNumber String
  team       TeamProfile @relation(fields: [teamId, teamNumber], references: [teamId, teamNumber], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id])

  @@unique([userId, teamNumber, teamId])
}

model FavoriteEvent {
  id      Int    @id @default(autoincrement())
  userId  String
  eventId Int
  user    User   @relation(fields: [userId], references: [id])

  @@unique([userId, eventId])
}

model MatchNotification {
  id             Int      @id @default(autoincrement())
  userId         String
  eventId        Int
  divisionId     Int
  checkRound     Int
  checkInstance  Int
  checkMatchnum  Int
  matchName      String
  phoneNumber    String
  checkMatchName String
  estimatedDate  DateTime
  User           User     @relation(fields: [userId], references: [id])

  @@unique([userId, eventId, divisionId, checkRound, checkInstance, checkMatchnum, phoneNumber, checkMatchName, matchName, estimatedDate])
}
