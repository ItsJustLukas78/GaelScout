generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model TeamProfile {
  teamId             Int                 @id
  teamName           String
  teamNumber         String              @unique
  robotName          String?             @default("No name")
  teamGrade          String?             @default("No grade")
  teamOrg            String?             @default("No org")
  teamCity           String?             @default("No city")
  teamRegion         String?             @default("No region")
  teamCountry        String?             @default("No country")
  programCode        String              @default("No program")
  programId          Int                 @default(0)
  TeamNotes          TeamNote[]
  TeamSeasonProfiles TeamSeasonProfile[]
  FavoriteTeam       FavoriteTeam[]

  @@unique([teamId, teamNumber])
}

model TeamSeasonProfile {
  id                      Int         @id @default(autoincrement())
  teamId                  Int
  teamName                String
  teamNumber              String
  seasonId                Int
  seasonName              String
  mu                      Float
  sigma                   Float
  openSkill               Float
  openSkillRank           Int
  opr                     Float
  dpr                     Float
  ccwm                    Float
  oprCum                  Float
  dprCum                  Float
  eventCount              Int
  topProgSkills           Int
  topDriverSkills         Int
  topTotalSkills          Int
  skillsRank              Int
  qualMatchCount          Int
  elimMatchCount          Int
  qualMatchWins           Int
  elimMatchWins           Int
  qualMatchLosses         Int
  elimMatchLosses         Int
  qualMatchWinPercentage  Float
  elimMatchWinPercentage  Float
  totalMatchWinPercentage Float
  qualToRegionals         Boolean
  awardQualToWorlds       Boolean
  team                    TeamProfile @relation(fields: [teamId], references: [teamId])

  @@unique([teamId, seasonId])
  @@unique([teamNumber, seasonId])
}

model SeasonAnalysis {
  seasonId                   Int      @id
  seasonName                 String   @unique
  numberOfTeams              Int
  numberOfEvents             Int
  lastEventDate              DateTime
  numberOfRegionalQualifiers Int?
  numberOfWorldsQualifiers   Int?
}

model TeamNote {
  id         Int         @id @default(autoincrement())
  teamId     Int
  note       Json
  userId     String
  seasonId   Int
  teamNumber String
  team       TeamProfile @relation(fields: [teamId, teamNumber], references: [teamId, teamNumber])

  @@unique([userId, seasonId, teamNumber, teamId])
}

model User {
  id             String          @id
  username       String?         @unique
  email          String?         @unique
  firstName      String?
  lastName       String?
  // teamNotes TeamNote[]
  favoriteTeams  FavoriteTeam[]
  favoriteEvents FavoriteEvent[]
}

model FavoriteTeam {
  id         Int         @id @default(autoincrement())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  teamId     Int
  teamNumber String
  team       TeamProfile @relation(fields: [teamId, teamNumber], references: [teamId, teamNumber], onUpdate: Cascade)

  @@unique([userId, teamNumber, teamId])
}

model FavoriteEvent {
  id      Int    @id @default(autoincrement())
  userId  String
  user    User   @relation(fields: [userId], references: [id])
  eventId Int

  @@unique([userId, eventId])
}
